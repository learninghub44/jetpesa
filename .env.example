# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never expose to the browser

# Paystack (Dashboard -> Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=
# Webhook URL to register: https://<your-domain>/api/paystack-webhook

# PayHero (optional second deposit provider)
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
# Callback URL used: <NEXT_PUBLIC_SITE_URL or request host>/api/payhero-callback
NEXT_PUBLIC_SITE_URL=

# Game fairness. Use a long random secret; never change it once live.
GAME_SERVER_SEED=
GAME_CLIENT_SEED=jetpesa_public_client_seed

# Your BCLB licence number. Deposits, bets and withdrawals stay disabled until this is set.
NEXT_PUBLIC_BCLB_LICENCE_NO=

# Email verification at signup (default on). Set to false to skip.
REQUIRE_EMAIL_VERIFICATION=true

# Optional limits
MAX_STAKE=10000
MAX_WITHDRAWAL=20000
