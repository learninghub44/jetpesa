# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never expose to the browser

# Paystack (Dashboard -> Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=
# Webhook URL to register: https://<your-domain>/api/paystack-webhook

# Game fairness. Use a long random secret; never change it once live.
GAME_SERVER_SEED=
GAME_CLIENT_SEED=jetpesa_public_client_seed

# Optional limits
MAX_STAKE=10000
MAX_WITHDRAWAL=20000
